{
  "name": "california-income-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fonts:check": "node scripts/checks/font-assets.mjs",
    "fonts:sync": "node scripts/sync-font-assets.mjs",
    "quality:check": "node scripts/checks/quality-budgets.mjs",
    "test": "vitest run",
    "test:fonts:browser": "node scripts/checks/font-browser.mjs",
    "test:quality:browser": "node scripts/checks/quality-browser.mjs",
    "test:pwa:browser": "node scripts/checks/pwa-browser.mjs",
    "test:firebase:emulator": "node scripts/run-firebase-emulator.mjs",
    "test:watch": "vitest",
    "verify": "node scripts/verify.mjs --mode full",
    "verify:quick": "node scripts/verify.mjs --mode quick"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/libre-caslon-display": "5.3.0",
    "@fontsource/long-cang": "5.3.0",
    "@fontsource/ma-shan-zheng": "5.3.1",
    "@fontsource/zcool-qingke-huangyou": "5.3.0",
    "@fontsource/zcool-xiaowei": "5.3.0",
    "@free-fonts/zhuque-fangsong": "1.0.0",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.32.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
